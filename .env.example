# Supabase (Project Settings -> API)
# The key may be labeled "anon public" or "publishable" depending on your project - either works here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key, labeled "service_role" or "secret". Server-only - never expose this.
# Only needed to send the daily reminder notifications (cron job).
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects the cron endpoint that sends daily reminders (any random string)
CRON_SECRET=

# Strava API (optional - only needed for the Strava integration)
# Create an app at https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Must match "Authorization Callback Domain" in your Strava API settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
